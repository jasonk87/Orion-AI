{
  "name": "orion-ai",
  "version": "2.0.0",
  "description": "Premium desktop pair-programmer application powered by Gemini 2.5 Flash-lite",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-packager . OrionAI --platform=win32 --arch=x64 --out=dist --overwrite --icon=assets/icon.ico --ignore=\"^/config\\.json$\" --ignore=\"^/standalone-workspaces($|/)\" --ignore=\"^/\\.orion($|/)\" --ignore=\"^/dist($|/)\" --ignore=\"^/tests($|/)\" --ignore=\"^/scripts($|/)\" --ignore=\"^/test-runner\\.js$\"",
    "test": "node test-runner.js",
    "smoke": "node scripts/smoke-packaged-app.js",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings 27",
    "check:line-endings": "node scripts/restore-line-endings.js --check agent.js renderer.js"
  },
  "keywords": ["orion","ai","pair-programmer","gemini","electron"],
  "author": "Antigravity Dev team",
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.29.7",
    "marked": "^12.0.1",
    "prismjs": "^1.30.0",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-packager": "^17.1.2",
    "eslint": "^9.39.5",
    "jsdom": "^29.1.1",
    "proxyquire": "^2.1.3",
    "sinon": "^22.0.0",
    "tape": "^5.9.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "undici": "7.29.0"
  }
}
