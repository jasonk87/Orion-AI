{
  "name": "word-count",
  "displayName": "Word Count",
  "description": "Counts words, sentences, and characters in a text string. Returns wordCount, sentenceCount, charCount, and charCountNoSpaces.",
  "group": "utility",
  "version": "1.0.0",
  "inputs": {
    "text": { "type": "string", "description": "The text to analyse", "required": true }
  },
  "outputs": {
    "wordCount": { "type": "number", "description": "Number of words" },
    "sentenceCount": { "type": "number", "description": "Number of sentences" },
    "charCount": { "type": "number", "description": "Total character count including spaces" },
    "charCountNoSpaces": { "type": "number", "description": "Character count excluding spaces" }
  },
  "createdBy": "human",
  "createdAt": "2026-06-29T00:00:00.000Z",
  "tested": true
}
